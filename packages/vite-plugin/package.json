{
  "name": "@squoosh-kit/vite-plugin",
  "version": "0.2.10",
  "type": "module",
  "description": "Vite plugin for Squoosh-Kit - handles asset copying and WASM configuration",
  "author": "Bartosz Nowak <bnowak008@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bnowak008/squoosh-kit.git",
    "directory": "packages/vite-plugin"
  },
  "homepage": "http://squoosh-kit.dev",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/**",
    "!dist/**/*.map",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bun run build.ts",
    "clean": "rm -rf dist node_modules .bun/install/cache bun.lockb bun.lock *.tsbuildinfo",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
